// ---------------- //
// Finite-state automaton functions
// ---------------- //

void init_every_second_timer() {

  // Set timer frequency to 1Mhz
  timer = timerBegin(1000000);

  // Attach onTimer function to our timer.
  timerAttachInterrupt(timer, &onTimer);

  // Set alarm to call onTimer function every second (value in microseconds).
  // Repeat the alarm (third parameter) with unlimited count = 0 (fourth parameter).
  timerAlarm(timer, 1000000, true, 0);
  
}

// TIMER VECTOR, gets called once a second (depends on prescaler and match register)
void ARDUINO_ISR_ATTR onTimer()
{
  //Serial.println(F("every-second-ISR called"));
  seconds_count_sleepy++;
  seconds_count_needy++;
  if (seconds_count_sleepy >= DELAY_SLEEPY_SEC
      && frogi_state == HAPPY) {
    change_state(SLEEPY);
  }
  if (seconds_count_needy >= DELAY_NEEDY_SEC
      && frogi_state != NEEDY) {
    change_state(NEEDY);
  }
}

void change_state(frogi_states new_state) {
  frogi_state = new_state;
  print_state();
}

void print_state() {
  Serial.print(F("State "));
  switch(frogi_state) {
    case HAPPY: { Serial.println(F("HAPPY")); break; }
    case SLEEPY: { Serial.println(F("SLEEPY")); break; }
    case NEEDY: { Serial.println(F("NEEDY")); break; }
    case LOVY: { Serial.println(F("LOVY")); break; }
  }
  
}

// ---------------- //
// Motion sensor functions
// ---------------- //

void motionISR() {
  Serial.println(F("Motion detected"));
  seconds_count_sleepy = 0;
  if (frogi_state == SLEEPY) {
    change_state(HAPPY);
  }
}

// ---------------- //
// Cuddle button functions
// ---------------- //

void buttonISR() {
  Serial.println(F("Cuddle detected"));
  seconds_count_sleepy = 0;
  seconds_count_needy = 0;
  change_state(LOVY);
}


// ---------------- //
// Behavior functions
// ---------------- //
void choose_new_happy_anim() {
  Serial.println(F("Choose new happy anim"));
  current_happy_anim = (current_happy_anim + 1) % HAPPY_ANIM_NUMBER;
}
