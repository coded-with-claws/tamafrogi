/*
 * Board : ESP32 Mini (ESP32-C3)
 * Display: 1.3" 128×64 SH1106 @ 0x3C
 * Library: Adafruit SH110X
 * Animations generated by OLED Display Animation Maker — https://www.oledanimationmaker.com/
 */

// OLED Display
// GPIO8 - SDA
// GPIO9 - SCL/SCK
// 3.3V - OLED VCC
// GND - OLED GND

// Cuddle button
// GPIO0 / GND

// Motion sensor
// GPIO1 / 5V / GND 

/*
 * Display a random startup animation
 * Initialize sleepy timer
 * Initialize needcare timer
 * Initialize every-second-timer with dedicated ISR routine
 * Initialize motion sensor with dedicated ISR routine
 * Initialize cuddle button with dedicated ISR routine
 * state = HAPPY
 * loop()
 *   IF state == HAPPY
 *     Choose randomly a happy animation
 *     WHILE state == HAPPY && N fois
 *       Display happy animation
 *   IF state == SLEEPY
 *     Choose randomly a sleepy animation
 *     WHILE state == SLEEPY
 *       Display sleepy animation
 *   IF state == NEEDCARE
 *     Choose randomly a needcare animation
 *     WHILE state == NEEDY
 *       Display needcare animation
 *   IF state == LOVY
 *     Choose randomly a love animation
 *       Display love animation
 *     state = HAPPY
 *
 * every_second_timer() & ISR()
 *   Increment sleepy timer
 *   Increment needcare timer
 *   IF sleepy timer reached && state == HAPPY
 *     state = SLEEPY
 *   IF needcare timer reached
 *     state = NEEDY
 *
 * motionISR()
 *   IF state == SLEEPY
 *     Reset sleepy timer
 *     state = HAPPY
 *
 * buttonISR()
 *   Reset sleepy timer
 *   Reset needcare timer
 *   state = LOVY
 *
 */

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SH110X.h>

#include "tamafrogi_happy1.h"
#include "tamafrogi_happy2.h"
#include "tamafrogi_love1.h"
#include "tamafrogi_need1.h"
#include "tamafrogi_sleep1.h"

// Display settings
#define SCREEN_WIDTH  128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
#define SCREEN_ADDR   0x3C

// Motion sensor settings
// D3 pin
#define motionSensor 1

// Cuddle button settings
// D2 pin
#define cuddleButton 0

// Finite-state automaton settings
enum frogi_states { HAPPY, SLEEPY, NEEDY, LOVY };
frogi_states frogi_state = HAPPY;
#define DELAY_SLEEPY_SEC 10
#define DELAY_NEEDY_SEC 30
#define HAPPY_ANIM_DISPLAY_TIMES 5

// other constants
#define HAPPY_ANIM_NUMBER 2 // number of happy animations (tamafrogi_happy1, etc)

// global variables
hw_timer_t * timer = NULL;
unsigned int seconds_count_sleepy = 0;
unsigned int seconds_count_needy = 0;
uint8_t current_happy_anim = 0;

Adafruit_SH1106G display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

void setup() {
  Serial.println(F("TAMAFROGI AWAKING"));
  
  // Serial init
  Serial.begin(9600);

  // Display init
  if (!display.begin(SCREEN_ADDR, true)) {
    Serial.println(F("SH1106 allocation failed"));
    for (;;);
  }
  display.setRotation(0);
  display.clearDisplay();
  display.display();
  Serial.println(F("Display initialized"));

  // Motion sensor init
  pinMode(motionSensor, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(motionSensor), motionISR, RISING);
  Serial.println(F("Motion sensor initialized"));
  
  // Cuddle button init
  pinMode(cuddleButton, INPUT_PULLUP);
  digitalWrite(cuddleButton, HIGH); // avoid getting a fake button pressed just after attaching interrupt
  attachInterrupt(digitalPinToInterrupt(cuddleButton), buttonISR, FALLING);
  Serial.println(F("Cuddle button initialized"));
  

  // Timer init
  init_every_second_timer();
}

void loop() {
  uint8_t anim_count = 0;
  
  disp_startup();
  
  Serial.print(F("loop - ")); print_state();
  switch(frogi_state) {
    case HAPPY: {
      // display a happy animation a few times (then next loop will display another animation if still happy)
      for(anim_count = 0; frogi_state == HAPPY && anim_count < HAPPY_ANIM_DISPLAY_TIMES; anim_count++) {
        disp_happy();
      }
      break;
    }
    case SLEEPY: {
      // display same animation while not awaken
      while(frogi_state == SLEEPY) {
        disp_sleepy();
      }
      break;
    }
    case NEEDY: {
      // display same animation while not taken care of
      while(frogi_state == NEEDY) {
        disp_needcare();
      }
      break;
    }
    case LOVY: {
      // display a love animation one time then become happy
      disp_love();
      change_state(HAPPY);
      break;
    }
  }

  // avoid full cpu loops in unexpected cases
  delay(0.5);

}

